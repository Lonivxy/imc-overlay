<Window x:Class="IMCBedwarsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="IMC.RE 起床战争" Width="680" Height="383" MinWidth="560" MinHeight="316"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0C1421"/><SolidColorBrush x:Key="Panel" Color="#151F2D"/>
    <SolidColorBrush x:Key="Panel2" Color="#1D2533"/><SolidColorBrush x:Key="Line" Color="#2B3546"/>
    <SolidColorBrush x:Key="Text" Color="#F1F5F9"/><SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Dim" Color="#64748B"/><SolidColorBrush x:Key="Green" Color="#34D399"/>
    <SolidColorBrush x:Key="Blue" Color="#38BDF8"/><SolidColorBrush x:Key="Amber" Color="#FBBF24"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#222B3A"/><Setter Property="BorderBrush" Value="#344155"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A3648"/><Setter TargetName="b" Property="BorderBrush" Value="#50627B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="AlternationCount" Value="2"/><Setter Property="RowBackground" Value="#111B29"/><Setter Property="AlternatingRowBackground" Value="#0E1825"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#171D29"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="4,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#2B3546"/></Style></Setter.Value></Setter><Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#253348"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></Style.Triggers></Style></Setter.Value></Setter><Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#202938"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{Binding Error}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D3041"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
  </Window.Resources>
  <Viewbox Stretch="Fill"><Border Width="980" Height="552" Background="{StaticResource Bg}" BorderBrush="#354155" BorderThickness="1" CornerRadius="16" Padding="1">
    <Grid x:Name="Root" ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="15,15,0,0" MouseLeftButtonDown="Header_Drag">
        <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Text="IMC.RE" Foreground="{StaticResource Text}" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="ModeTitle" Text="起床战争" Foreground="#CBD5E1" FontSize="18" Margin="12,1,0,0"/></StackPanel>
          <TextBlock Grid.Column="1" Text="按空格后按 TAB 扫描 · 点击玩家行复制战绩" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <Button Grid.Column="2" Content="查询玩家" Click="Search_Click" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Grid.Column="3" Content="设置" Click="Settings_Click" VerticalAlignment="Center"/><Button Grid.Column="4" Content="×" ToolTip="退出程序" Click="Close_Click" VerticalAlignment="Center" FontSize="18" Padding="10,2" Margin="8,0,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0"><DataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True" Sorting="PlayersGrid_Sorting" MouseDoubleClick="PlayersGrid_DoubleClick" MouseLeftButtonUp="PlayersGrid_Click">
        <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGrid.Resources><DataGrid.Columns>
          <DataGridTemplateColumn Header="玩家" Width="2.2*" SortMemberPath="Username"><DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#171D29"/><Setter Property="Foreground" Value="#94A3B8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#2B3546"/></Style></DataGridTemplateColumn.HeaderStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><Border Width="28" Height="28" CornerRadius="5" Background="#273547" BorderBrush="#42556B" BorderThickness="1" Margin="0,0,8,0"><Grid><TextBlock Text="·" FontSize="18" Foreground="#73859A" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Avatar}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid></Border><TextBlock Text="{Binding Username}" Foreground="#F3F7FC" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="威胁" Width="*" SortMemberPath="threat"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="badge" Background="#202A39" BorderBrush="#344155" BorderThickness="1" CornerRadius="6" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="label" Text="{Binding ThreatLabel}" Foreground="#A9B7CA" FontWeight="SemiBold" FontSize="12"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding ThreatLabel}" Value="极危"><Setter TargetName="badge" Property="Background" Value="#351923"/><Setter TargetName="badge" Property="BorderBrush" Value="#A83B52"/><Setter TargetName="label" Property="Foreground" Value="#FB7185"/></DataTrigger><DataTrigger Binding="{Binding ThreatLabel}" Value="危险"><Setter TargetName="badge" Property="Background" Value="#352812"/><Setter TargetName="badge" Property="BorderBrush" Value="#956B22"/><Setter TargetName="label" Property="Foreground" Value="#FBBF24"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="胜率" SortMemberPath="WinRate" Binding="{Binding WinRateLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{Binding WinRateColor}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="MVP" SortMemberPath="MVPs" Binding="{Binding MVPsLabel}" Width=".8*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{Binding MVPColor}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="FKDR" SortMemberPath="Fkdr" Binding="{Binding FkdrLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{Binding FkdrColor}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="拆床" SortMemberPath="BedsBroken" Binding="{Binding BedsLabel}" Width=".8*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="终杀" SortMemberPath="FinalKills" Binding="{Binding FinalsLabel}" Width=".8*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="击杀" SortMemberPath="Kills" Binding="{Binding KillsLabel}" Width=".8*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="场次 / 状态" SortMemberPath="Matches" Binding="{Binding MatchesLabel}" Width="1.2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="Rating" SortMemberPath="Rating" Binding="{Binding RatingLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#79C7F2"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="K/D" SortMemberPath="KD" Binding="{Binding KDLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#79C7F2"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="ADR" SortMemberPath="Adr" Binding="{Binding AdrLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#79C7F2"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="爆头率" SortMemberPath="HsRate" Binding="{Binding HsRateLabel}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#79C7F2"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
        <Border x:Name="EmptyPanel" Background="#AA10141D" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="等待玩家名单" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="进入 IMC.RE 大厅，按空格后按 TAB 扫描。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="0,0,15,15" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterStatus" Text="就绪" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid></Border>
      <Border x:Name="ModalShade" Grid.RowSpan="3" Background="#B80A0D13" Visibility="Collapsed" CornerRadius="15"><Grid><Border Width="620" Height="390" Background="#171D29" BorderBrush="#344155" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="ModalTitle" Text="查询玩家战绩" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold"/><Button Content="关闭" DockPanel.Dock="Right" Click="ModalClose_Click" Padding="10,4"/></DockPanel><Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="40" VerticalContentAlignment="Center" Padding="12,0" Background="#10141D" Foreground="{StaticResource Text}" BorderBrush="#344155" CaretBrush="White" FontSize="14" KeyDown="SearchBox_KeyDown"/><Button Grid.Column="1" Content="查询" Background="#087F68" Margin="10,0,0,0" Click="SearchSubmit_Click"/></Grid><TextBlock x:Name="ModalMessage" Grid.Row="2" Text="输入 Minecraft 玩家名并查询。" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyButton" Content="复制战绩" Visibility="Collapsed" Click="CopySearch_Click"/></StackPanel></Grid></Border></Grid></Border>
      <Border x:Name="SettingsShade" Grid.RowSpan="3" Background="#B80A0D13" Visibility="Collapsed" CornerRadius="15"><Border Width="570" Height="410" Background="#171D29" BorderBrush="#344155" BorderThickness="1" CornerRadius="16" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="显示设置" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold"/><Button Content="关闭" DockPanel.Dock="Right" Click="SettingsClose_Click" Padding="10,4"/></DockPanel><StackPanel Grid.Row="1" Margin="0,24,0,10"><TextBlock Text="查询模式" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ModeCombo" SelectedIndex="0" Height="34" Margin="0,5,0,12"><ComboBoxItem Content="起床战争 (BW)"/><ComboBoxItem Content="CounterEmber"/></ComboBox><TextBlock Text="显隐快捷键" Foreground="{StaticResource Muted}"/><TextBox x:Name="HotkeyBox" Text="\" IsReadOnly="True" Height="38" Background="#10141D" Foreground="{StaticResource Text}" BorderBrush="#344155" Padding="10" VerticalContentAlignment="Center" Margin="0,8,0,18"/><CheckBox x:Name="ForceImcBox" Content="忽略服务器地址检测，始终启用扫描" Foreground="{StaticResource Text}" IsChecked="True"/><TextBlock Text="窗口不透明度" Foreground="{StaticResource Muted}" Margin="0,16,0,4"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Foreground="{StaticResource Text}" Margin="12,0,0,0"/><Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" Value="0.9" IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/></DockPanel><TextBlock Text="拖动窗口右下角按比例缩放。" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel><TextBlock Grid.Row="2" Text="按反斜杠键显示或隐藏悬浮窗。" Foreground="{StaticResource Dim}"/></Grid></Border></Border>
      <primitives:Thumb Grid.RowSpan="3" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" ToolTip="拖动调整窗口大小" DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"><primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="#8CA0B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
    </Grid>
  </Border></Viewbox>
</Window>
