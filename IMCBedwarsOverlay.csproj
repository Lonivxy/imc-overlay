<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>IMCBedwarsOverlay-CSharp</AssemblyName>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-radar</InformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);IMCBedwarsOverlay.exe;IMCBedwarsOverlay.exe~;legacy-go/**;publish/**;publish-single/**;publish-csharp/**;publish-framework/**;release-csharp/**;release-update/**;release-v3/**;release-v4/**;release-v5/**;release-v6/**;release-v7/**;work/**;tests/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Overlay.Checks" />
  </ItemGroup>

</Project>
