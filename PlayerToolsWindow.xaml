<Window x:Class="IMCBedwarsOverlay.PlayerToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="玩家分析工具" Width="780" Height="610" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#0F141E" Foreground="#E7EDF6"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="Background" Value="#202B3B"/>
      <Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="#E7EDF6"/>
      <Setter Property="BorderBrush" Value="#344155"/><Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="#E7EDF6"/>
      <Setter Property="BorderBrush" Value="#344155"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#111B29"/><Setter Property="Foreground" Value="#E7EDF6"/>
      <Setter Property="Padding" Value="8,6"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#253348"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D3041"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#111B29"/><Setter Property="Foreground" Value="#E7EDF6"/>
      <Setter Property="BorderBrush" Value="#2B3546"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#202938"/><Setter Property="RowBackground" Value="#111B29"/>
      <Setter Property="AlternatingRowBackground" Value="#0E1825"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="38"/>
      <Setter Property="ColumnHeaderHeight" Value="36"/>
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#171D29"/><Setter Property="Foreground" Value="#9CAEC4"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click"/>
      <StackPanel>
        <TextBlock x:Name="WindowTitle" Text="玩家分析工具" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="WindowSubtitle" Text="按 IMC.RE 当前模式数据进行对比分析" Foreground="#8FA1B7" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="游戏模式" Foreground="#AAB8CA" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="ModeCombo" Grid.Column="1" Height="34" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
        <ComboBoxItem Content="起床战争 (BW)" Tag="bedwars"/>
        <ComboBoxItem Content="CounterEmber" Tag="counterember"/>
      </ComboBox>
      <TextBlock Grid.Column="2" x:Name="ModeNote" Text="Rating Pro 为项目估算值；样本量不足时会显示 *。" Foreground="#7F91A7" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
    </Grid>
    <StackPanel x:Name="PartyInputPanel" Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="车队成员（2–4 人，空格或逗号分隔）" Foreground="#AAB8CA" Margin="0,0,0,5"/>
      <TextBox x:Name="PartyNamesBox" Height="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="将逐个查询数据，并按模式分配互补职责。离线重名玩家保留前缀 -（如 -yys_wys）；所有成员都需要有对应模式的有效数据。" Foreground="#73869C" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid x:Name="VsInputPanel" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="红方玩家" Foreground="#FDA4AF" Margin="0,0,0,5"/><TextBox x:Name="RedNameBox" Height="38"/></StackPanel>
      <TextBlock Grid.Column="1" Text="VS" Foreground="#94A3B8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
      <StackPanel Grid.Column="2"><TextBlock Text="蓝方玩家" Foreground="#7DD3FC" Margin="0,0,0,5"/><TextBox x:Name="BlueNameBox" Height="38"/></StackPanel>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,0,0,12">
      <Button x:Name="RunButton" DockPanel.Dock="Right" Content="开始分析" Background="#087F68" BorderBrush="#0F9D7A" Click="Run_Click"/>
      <TextBlock x:Name="StatusText" Text="输入玩家名后开始。" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
    </DockPanel>
    <Border Grid.Row="4" Background="#141D2A" BorderBrush="#2A394D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <TextBlock x:Name="SummaryText" Text="分析结果会显示在这里。" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </Border>
    <DataGrid x:Name="PartyResultsGrid" Grid.Row="5" AutoGenerateColumns="False" AlternationCount="2" Visibility="Collapsed">
      <DataGrid.Columns>
        <DataGridTextColumn Header="玩家" Binding="{Binding Username}" Width="1.35*"/>
        <DataGridTextColumn Header="职责" Binding="{Binding Role}" Width="1.5*"/>
        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width=".8*"/>
        <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width=".8*"/>
        <DataGridTextColumn Header="场次" Binding="{Binding Matches}" Width=".65*"/>
        <DataGridTextColumn Header="核心指标" Binding="{Binding Metrics}" Width="2.3*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid x:Name="VsResultsGrid" Grid.Row="5" AutoGenerateColumns="False" AlternationCount="2" Visibility="Collapsed">
      <DataGrid.Columns>
        <DataGridTextColumn Header="指标" Binding="{Binding Metric}" Width="1.1*"/>
        <DataGridTextColumn Header="红方" Binding="{Binding RedValue}" Width="1.2*"/>
        <DataGridTextColumn Header="蓝方" Binding="{Binding BlueValue}" Width="1.2*"/>
        <DataGridTextColumn Header="优势" Binding="{Binding Advantage}" Width="1.4*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="6" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" x:Name="CopyResultButton" Content="复制分析" IsEnabled="False" Click="CopyResult_Click"/>
      <TextBlock Text="结果根据当前模式的有效数据逐项比较；跨模式评分不作比较。" Foreground="#71839A" FontSize="11" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
